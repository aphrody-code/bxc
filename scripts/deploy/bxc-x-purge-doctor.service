[Unit]
Description=Bxc X — doctor des purges (surveille et répare unfollow + purge-tweets)
Documentation=https://github.com/aphrody-code/bxc
After=network-online.target

[Service]
Type=oneshot
# Root : le doctor pilote systemctl et rebascule sur l'utilisateur de la
# session (runuser) pour tout ce qui touche aux journaux et aux cookies.
User=root
ExecStart=/usr/local/bin/bxc-x-purge-doctor
TimeoutStartSec=2400

# Le doctor ne se répare pas lui-même : s'il échoue, le prochain tick du timer
# repasse. Un Restart= ici ne ferait que masquer une panne franche.
Restart=no

# Les journaux nomment le compte et le contenu supprime : meme exigence que les
# journaux de reprise en 0600. Sans UMask, systemd cree le .log en 0644.
UMask=0077

StandardOutput=append:/var/log/bxc/x-purge-doctor.log
StandardError=append:/var/log/bxc/x-purge-doctor.log

[Install]
WantedBy=multi-user.target
